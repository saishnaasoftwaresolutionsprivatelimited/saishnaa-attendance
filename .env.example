# Shift Defaults
DEFAULT_GRACE_PERIOD_MINUTES=10
DEFAULT_HALF_DAY_THRESHOLD_MINUTES=240
DEFAULT_FULL_DAY_THRESHOLD_MINUTES=480

# Email
SMTP_HOST=smtp.gmail.com
